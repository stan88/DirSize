// Version information for @VER_NAME@.exe. Generated from
// cmake/version.rc.in; the version comes from project(VERSION) in
// CMakeLists.txt. ASCII only.
#include <winver.h>

#ifdef _DEBUG
#define VER_DEBUG VS_FF_DEBUG
#else
#define VER_DEBUG 0
#endif

VS_VERSION_INFO VERSIONINFO
FILEVERSION     @VER_MAJOR@,@VER_MINOR@,@VER_PATCH@,0
PRODUCTVERSION  @VER_MAJOR@,@VER_MINOR@,@VER_PATCH@,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       VER_DEBUG
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        // U.S. English (0x0409), Unicode (1200 = 0x04B0).
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "@VER_COMPANY@"
            VALUE "FileDescription",  "@VER_DESCRIPTION@"
            VALUE "FileVersion",      "@VER_STRING@"
            VALUE "InternalName",     "@VER_NAME@"
            VALUE "LegalCopyright",   "@VER_COPYRIGHT@"
            VALUE "OriginalFilename", "@VER_NAME@.exe"
            VALUE "ProductName",      "DirSize"
            VALUE "ProductVersion",   "@VER_STRING@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
