# Turns lang/<locale>.json into string tables (docs/DESIGN-phase6.md section 5,
# lang/README.md). Run by the build:
#
#   cmake -DLANG_DIR=<lang> -DIDS_HEADER=<string_ids.h> -DOUT_DIR=<dir> -P gen_lang.cmake
#
# Writes into OUT_DIR:
#   lang.rc            one STRINGTABLE per language (compiled into dirsize.exe)
#   languages.inc      the language table read by src/ui/language.cpp
#   lang_expected.inc  every string as text, for tests/ui_tests.cpp
#
# en-US.json is the base and must have every ID in string_ids.h. Another
# language that lacks an ID gets the English text and a warning: Windows does
# not fall back to another language for a single missing string (DEVLOG
# 2026-11-06), so every table must be complete. A string's %1..%9 placeholders
# must be the same as in English.

cmake_minimum_required(VERSION 3.20)

foreach(var LANG_DIR IDS_HEADER OUT_DIR)
    if(NOT DEFINED ${var})
        message(FATAL_ERROR "gen_lang.cmake: ${var} is not set")
    endif()
endforeach()

# --- IDs ----------------------------------------------------------------------
file(STRINGS "${IDS_HEADER}" id_lines REGEX "^#define[ \t]+IDS_[A-Z0-9_]+[ \t]+[0-9]+")
set(ids "")
foreach(line IN LISTS id_lines)
    string(REGEX REPLACE "^#define[ \t]+(IDS_[A-Z0-9_]+).*$" "\\1" name "${line}")
    list(APPEND ids "${name}")
endforeach()
list(LENGTH ids id_count)
if(id_count EQUAL 0)
    message(FATAL_ERROR "gen_lang.cmake: no IDS_ defines in ${IDS_HEADER}")
endif()

# --- helpers --------------------------------------------------------------------
# Reads a JSON file, dropping a UTF-8 byte order mark (Notepad writes one).
function(read_json path out)
    file(READ "${path}" head HEX LIMIT 3)
    file(READ "${path}" text)
    if(head STREQUAL "efbbbf")
        string(SUBSTRING "${text}" 3 -1 text)
    endif()
    string(JSON kind ERROR_VARIABLE err TYPE "${text}")
    if(NOT err STREQUAL "NOTFOUND" OR NOT kind STREQUAL "OBJECT")
        message(FATAL_ERROR "${path}: not a JSON object: ${err}")
    endif()
    set(${out} "${text}" PARENT_SCOPE)
endfunction()

# A required string member.
function(json_string json path member out)
    string(JSON value ERROR_VARIABLE err GET "${json}" "${member}")
    if(NOT err STREQUAL "NOTFOUND")
        message(FATAL_ERROR "${path}: missing \"${member}\"")
    endif()
    set(${out} "${value}" PARENT_SCOPE)
endfunction()

# The sorted %1..%9 placeholders of a string, as "%1,%2".
function(placeholders text out)
    string(REGEX MATCHALL "%[1-9]" found "${text}")
    if(found)
        list(REMOVE_DUPLICATES found)
        list(SORT found)
    endif()
    string(JOIN "," joined ${found})
    set(${out} "${joined}" PARENT_SCOPE)
endfunction()

# Escapes for a resource script string: \ -> \\, " -> "", tab -> \t, newline -> \n.
function(rc_escape text out)
    string(REPLACE "\\" "\\\\" text "${text}")
    string(REPLACE "\"" "\"\"" text "${text}")
    string(REPLACE "\t" "\\t" text "${text}")
    string(REPLACE "\n" "\\n" text "${text}")
    set(${out} "${text}" PARENT_SCOPE)
endfunction()

# Escapes for a C++ narrow string literal (the build uses /utf-8).
function(cpp_escape text out)
    string(REPLACE "\\" "\\\\" text "${text}")
    string(REPLACE "\"" "\\\"" text "${text}")
    string(REPLACE "\t" "\\t" text "${text}")
    string(REPLACE "\n" "\\n" text "${text}")
    set(${out} "${text}" PARENT_SCOPE)
endfunction()

# --- English base -------------------------------------------------------------
set(base_path "${LANG_DIR}/en-US.json")
if(NOT EXISTS "${base_path}")
    message(FATAL_ERROR "gen_lang.cmake: ${base_path} is missing")
endif()
read_json("${base_path}" base_json)
foreach(id IN LISTS ids)
    string(JSON text ERROR_VARIABLE err GET "${base_json}" strings "${id}")
    if(NOT err STREQUAL "NOTFOUND")
        message(FATAL_ERROR "${base_path}: missing string ${id}")
    endif()
    set("base_${id}" "${text}")
endforeach()

# --- every language -------------------------------------------------------------
file(GLOB lang_files "${LANG_DIR}/*.json")
list(SORT lang_files)
set(rc "// Generated by cmake/gen_lang.cmake from lang/*.json. Do not edit.\n#pragma code_page(65001)\n\n#include <winres.h>\n#include \"ui/string_ids.h\"\n")
set(table "// Generated by cmake/gen_lang.cmake from lang/*.json. Do not edit.\n")
set(entries "")
set(expected "// Generated by cmake/gen_lang.cmake from lang/*.json. Do not edit.\n")
set(index 0)
set(problems 0)

foreach(path IN LISTS lang_files)
    get_filename_component(file_locale "${path}" NAME_WE)
    read_json("${path}" json)
    json_string("${json}" "${path}" locale locale)
    json_string("${json}" "${path}" language language)
    json_string("${json}" "${path}" sublanguage sublanguage)
    if(NOT locale STREQUAL file_locale)
        message(FATAL_ERROR "${path}: \"locale\" is ${locale}; the file must be named ${locale}.json")
    endif()
    if(NOT locale MATCHES "^[A-Za-z]+(-[A-Za-z0-9]+)*$")
        message(FATAL_ERROR "${path}: \"locale\" ${locale} is not a locale name such as ja-JP")
    endif()
    if(NOT language MATCHES "^LANG_[A-Z_]+$" OR NOT sublanguage MATCHES "^SUBLANG_[A-Z0-9_]+$")
        message(FATAL_ERROR "${path}: \"language\" and \"sublanguage\" must be winnt.h names such as LANG_JAPANESE, SUBLANG_JAPANESE_JAPAN")
    endif()

    # matches: locale names this file serves, besides its own.
    set(match_items "")
    string(JSON match_kind ERROR_VARIABLE err TYPE "${json}" matches)
    if(err STREQUAL "NOTFOUND")
        if(NOT match_kind STREQUAL "ARRAY")
            message(FATAL_ERROR "${path}: \"matches\" must be an array of locale names")
        endif()
        string(JSON match_count LENGTH "${json}" matches)
        if(match_count GREATER 0)
            math(EXPR last "${match_count} - 1")
            foreach(i RANGE ${last})
                string(JSON m GET "${json}" matches ${i})
                if(NOT m MATCHES "^[A-Za-z]+(-[A-Za-z0-9]+)*$")
                    message(FATAL_ERROR "${path}: matches entry \"${m}\" is not a locale name")
                endif()
                string(APPEND match_items "L\"${m}\", ")
            endforeach()
        endif()
    endif()

    # Strings that are not IDs (typos, removed IDs).
    string(JSON member_count ERROR_VARIABLE err LENGTH "${json}" strings)
    if(NOT err STREQUAL "NOTFOUND")
        message(FATAL_ERROR "${path}: missing \"strings\" object")
    endif()
    if(member_count GREATER 0)
        math(EXPR last "${member_count} - 1")
        foreach(i RANGE ${last})
            string(JSON key MEMBER "${json}" strings ${i})
            if(NOT key IN_LIST ids)
                message(FATAL_ERROR "${path}: \"${key}\" is not an ID in string_ids.h")
            endif()
        endforeach()
    endif()

    string(APPEND rc "\nLANGUAGE ${language}, ${sublanguage}\nSTRINGTABLE\nBEGIN\n")
    foreach(id IN LISTS ids)
        string(JSON text ERROR_VARIABLE err GET "${json}" strings "${id}")
        if(NOT err STREQUAL "NOTFOUND")
            message(WARNING "${path}: no translation for ${id}; using the English text")
            set(text "${base_${id}}")
        endif()
        placeholders("${text}" got)
        placeholders("${base_${id}}" want)
        if(NOT got STREQUAL want)
            message(SEND_ERROR "${path}: ${id} has placeholders [${got}], English has [${want}]")
            math(EXPR problems "${problems} + 1")
        endif()
        rc_escape("${text}" rc_text)
        cpp_escape("${text}" cpp_text)
        string(APPEND rc "    ${id} \"${rc_text}\"\n")
        string(APPEND expected "{L\"${locale}\", ${id}, \"${cpp_text}\"},\n")
    endforeach()
    string(APPEND rc "END\n")

    string(APPEND table "static const wchar_t* const kMatches${index}[] = {${match_items}nullptr};\n")
    string(APPEND entries "    {L\"${locale}\", MAKELANGID(${language}, ${sublanguage}), kMatches${index}},\n")
    math(EXPR index "${index} + 1")
endforeach()

if(problems GREATER 0)
    message(FATAL_ERROR "gen_lang.cmake: ${problems} problem(s) in lang/*.json")
endif()

string(APPEND table "static const LanguageEntry kLanguageTable[] = {\n${entries}};\n")

file(MAKE_DIRECTORY "${OUT_DIR}")
file(WRITE "${OUT_DIR}/lang.rc" "${rc}")
file(WRITE "${OUT_DIR}/languages.inc" "${table}")
file(WRITE "${OUT_DIR}/lang_expected.inc" "${expected}")
